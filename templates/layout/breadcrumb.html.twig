<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        {% if wo_breadcrumbs()|length > 0 %}
            <li class="breadcrumb-item">
                <a href="/">Accueil</a>
            </li>
        {% else %}
            <li class="breadcrumb-item active" aria-current="page">
                Accueil
            </li>
        {% endif %}

        {% for item in breadcrumbs %}
            {# @var item Huluti\BreadcrumbsBundle\Model\SingleBreadcrumb #}

            {% if not loop.last %}
                <li class="breadcrumb-item">
                    <a href="{{ item.url }}">
                        <twig:truncated-text :text="item.text" size="30" />
                    </a>
                </li>
            {% else %}
                <li class="breadcrumb-item active" aria-current="page">
                    <twig:truncated-text :text="item.text" size="30" />
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
