<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        {% if not slope_it_is_breadcrumb_empty() %}
            <li class="breadcrumb-item">
                <a href="/">Accueil</a>
            </li>
        {% else %}
            <li class="breadcrumb-item active" aria-current="page">
                Accueil
            </li>
        {% endif %}

        {% for item in items %}
            {# @var item SlopeIt\BreadcrumbBundle\Model\ProcessedBreadcrumbItem #}

            {% if not loop.last %}
                <li class="breadcrumb-item">
                    <a href="{{ item.url }}">{{ item.translatedLabel }}</a>
                </li>
            {% else %}
                <li class="breadcrumb-item active" aria-current="page">
                    {{ item.translatedLabel }}
                </li>
            {% endif %}
        {% endfor %}
    </ol>
</nav>
