{#
    menu_items: [
        {
            title: Nom du lien (string),
            icon: Classe de l'icône Bootstrap Icons (Icon),
            href: Chemin du lien (string) (facultatif si sub_items est défini),
            additional_classes: Classes CSS à appliquer sur l'élément (string) (facultatif),
            when: Condition pour afficher l'élément (bool),
            sub_items: Sous-éléments à afficher en dropdown (array) (facultatif) [
                {
                    title: Nom du sous-lien (string),
                    icon: Classe de l'icône Bootstrap Icons (Icon),
                    href: Chemin du lien (string),
                    additional_classes: Classes CSS à appliquer sur le sous élément (string) (facultatif),
                    when: Condition pour afficher le sous-élément (bool),
                },
            ],
        },
    ]
#}

{% set menu_items = [
    {
        title: 'Base de données',
        icon: Icon.database,
        sub_items: [
            {
                title: 'Jeux vidéo',
                icon: Icon.game,
                href: '#ToDo',
                additional_classes: 'sidebar-icon-color-game',
            },
            {
                title: 'Extensions',
                icon: Icon.extension,
                href: '#ToDo',
                additional_classes: 'sidebar-icon-color-extension',
            },
            {
                title: 'Plateformes',
                icon: Icon.console,
                href: '#ToDo',
                additional_classes: 'sidebar-icon-color-console',
            },
            {
                title: 'Accessoires',
                icon: Icon.accessory,
                href: '#ToDo',
                additional_classes: 'sidebar-icon-color-accessory',
            },
            {
                title: 'Jouets vidéo',
                icon: Icon.toy,
                href: '#ToDo',
                additional_classes: 'sidebar-icon-color-toy',
            },
        ],
    },
    {
        title: 'Membres',
        icon: Icon.members,
        sub_items: [
            {
                title: 'Collections',
                icon: Icon.collection,
                href: '#ToDo',
            },
            {
                title: 'Wishlists',
                icon: Icon.wishlist,
                href: '#ToDo',
            },
            {
                title: 'Listes',
                icon: Icon.user_list,
                href: '#ToDo',
            },
        ],
    },
    {
        title: 'Hall of Fame',
        icon: Icon.hall_of_fame,
        href: '#ToDo',
    },
    {
        title: 'Aide',
        icon: Icon.help,
        href: '#ToDo',
    },
    {
        title: 'Administration',
        icon: Icon.administration,
        href: '#ToDo',
        when: is_granted('ROLE_ADMIN'),
    },
] %}

{% set user_items = [
    {
        title: 'Connexion/Inscription',
        icon: Icon.log_sign_in,
        href: path('security.login'),
        when: app.user is null,
    },
    {
        title: app.user.username|default(),
        icon: Icon.logged_in_user,
        when: app.user is not null,
        sub_items: [
            {
                title: 'Ma collection',
                icon: Icon.collection,
                href: '#ToDo',
            },
            {
                title: 'Ma wishlist',
                icon: Icon.wishlist,
                href: '#ToDo',
            },
            {
                title: 'Mes listes',
                icon: Icon.user_list,
                href: '#ToDo',
            },
            {
                title: 'Mon profil',
                icon: Icon.profile,
                href: '#ToDo',
            },
            {
                title: 'Mes statistiques',
                icon: Icon.stats,
                href: '#ToDo',
            },
            {
                title: 'Déconnexion',
                icon: Icon.log_out,
                href: path('security.logout'),
            },
        ],
    },
] %}

<div class="sidebar-wrapper">
    <div class="sidebar-content">
        <a href="/" class="sidebar-brand">
            <img src="{{ asset('images/app/logo100px.png') }}" alt="LudoCollec" />
        </a>

        <ul class="sidebar-menu" id="menu">
            {% for item in menu_items %}
                {% if item.when is not defined %}
                    {% set when = true %}
                {% else %}
                    {% set when = item.when %}
                {% endif %}

                {% if when is true %}
                    {% if item.sub_items is not defined %}
                        {% include 'layout/sidebar/_item.html.twig' with {
                            title: item.title,
                            icon: item.icon,
                            href: item.href,
                            additional_classes: item.additional_classes|default(),
                        } only %}
                    {% else %}
                        {% include 'layout/sidebar/_dropdown.html.twig' with {
                            title: item.title,
                            icon: item.icon,
                            additional_classes: item.additional_classes|default(),
                            items: item.sub_items,
                        } only %}
                    {% endif %}
                {% endif %}
            {% endfor %}
        </ul>

        <ul class="sidebar-menu sidebar-menu-bottom">
        {% for item in user_items %}
            {% if item.when is not defined %}
                {% set when = true %}
            {% else %}
                {% set when = item.when %}
            {% endif %}

            {% if when is true %}
                {% if item.sub_items is not defined %}
                    {% include 'layout/sidebar/_item.html.twig' with {
                        title: item.title,
                        icon: item.icon,
                        href: item.href,
                        additional_classes: item.additional_classes|default(),
                    } only %}
                {% else %}
                    {% include 'layout/sidebar/_dropdown.html.twig' with {
                        title: item.title,
                        icon: item.icon,
                        additional_classes: item.additional_classes|default(),
                        items: item.sub_items,
                    } only %}
                {% endif %}
            {% endif %}
        {% endfor %}
        </ul>
    </div>
</div>
