{% extends 'bootstrap_5_layout.html.twig' %}

{% block filter_text_widget %}
    {% if compound %}
        <div class="row gx-2">
            <div class="col-12 col-sm-5">
                {{ form_widget(form.condition_pattern) }}
            </div>
            <div class="col-12 col-sm">
                {{ form_widget(form.text) }}
            </div>
        </div>
    {% else %}
        {{ block('form_widget_simple') }}
    {% endif %}
{% endblock filter_text_widget %}

{% block filter_date_range_widget %}
    <div class="d-flex align-items-center">
        <div class="flex-grow-1" title="Du">
            {{ form_widget(form.left_date) }}
        </div>
        <div class="flex-shrink-1 mx-1">
            <twig:icon :icon="Icon.arrow_right" />
        </div>
        <div class="flex-grow-1" title="Au">
            {{ form_widget(form.right_date) }}
        </div>
    </div>
{% endblock filter_date_range_widget %}

{%- block fieldset_filter_row -%}
    <div class="fieldset-filter">
        <div class="fieldset-filter-label">{{ form_label(form) }}</div>

        <div class="fieldset-filter-content">
            {{ form_widget(form) }}
            {{ form_errors(form) }}
        </div>
    </div>
{%- endblock -%}
