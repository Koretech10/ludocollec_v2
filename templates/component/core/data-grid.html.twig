{{ knp_pagination_rel_links(this.pager) }}

<table>
    <thead>
    <tr>
        <th>{{ knp_pagination_sortable(this.pager, 'Nom', 'toy.name') }}</th>
        <th>{{ knp_pagination_sortable(this.pager, 'Série', 'series.name') }}</th>
        <th>{{ knp_pagination_sortable(this.pager, 'Fabricant', 'manufacturer.name') }}</th>
        <th>{{ knp_pagination_sortable(this.pager, 'Sortie', 'toy.releaseDate') }}</th>
    </tr>
    </thead>
    <tbody>
    {% for toy in this.pager %}
        {# @var toy App\Entity\Toy\Toy #}
        <tr>
            <td>{{ toy.name }}</td>
            <td>{{ toy.series.name }} ({{ toy.series.brand.label }})</td>
            <td>{{ toy.manufacturer.name }}</td>
            <td>{{ toy.releaseDate|date('d/m/Y') }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

{{ knp_pagination_render(this.pager) }}
