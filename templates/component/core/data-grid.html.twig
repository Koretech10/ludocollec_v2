{% set pagination %}
    <twig:data-grid-pagination
        :pager="this.pager"
        :filterModalId="this.filterModalId"
        :hasFilterType="this.hasFilterType"
        :isFiltered="this.dataGrid.isFiltered"
    />
{% endset %}

{{ knp_pagination_rel_links(this.pager) }}

{% if this.hasFilterType %}
    <twig:modal :id="this.filterModalId">
        <twig:block name="title"><twig:icon :icon="Icon.filter" /> Filtrer</twig:block>

        {% set filterType = outerScope.this.filterType %}

        {% form_theme filterType 'form/filter_type_theme.html.twig' %}

        {{ form_start(filterType) }}
        {{ form_rest(filterType) }}
        <div class="row g-2">
            <div class="col-12">
                <twig:button additionalClasses="btn-auto" submit>
                    <twig:icon :icon="Icon.filter" />
                    Filtrer
                </twig:button>
            </div>
            <div class="col-12">
                <twig:button additionalClasses="btn-auto" :type="Type.DANGER" :href="path(app.current_route)" outlined>
                    <twig:icon :icon="Icon.cancel" />
                    Annuler la recherche
                </twig:button>
            </div>
        </div>
        {{ form_end(filterType) }}
    </twig:modal>
{% endif %}

{{ pagination }}

{% if this.displayListType.isCardGrid %}
    <div class="row row-cols-1 row-cols-sm-3 g-2">
        {% for item in this.pager %}
            {# @var item \App\Entity\ImageableEntity #}

            {%- set card_body -%}
                {% block card_body %}{% endblock %}
            {%- endset -%}

            <div class="col">
                <twig:entity-card cardClass="h-100" :entity="item">
                    {{ card_body }}
                </twig:entity-card>
            </div>
        {% endfor %}
    </div>
{% endif %}

{% if this.displayListType.isTable %}
    <div class="table-responsive">
        <table class="table data-grid-table">
            <thead>
            <tr>
                {% if this.displayListType.isImagedTable %}
                    <th>&nbsp;</th>
                {% endif %}

                {% for header in this.headers %}
                    {# @var header \App\Model\Core\DataGrid\DataGridHeader #}

                    {% if header.key is null %}
                        <th>{{ header.label }}</th>
                    {% else %}
                        <th>{{ knp_pagination_sortable(this.pager, header.label, header.key) }}</th>
                    {% endif %}
                {% endfor %}

                {% if not this.hideActions %}
                    <th>&nbsp;</th>
                {% endif %}
            </tr>
            </thead>
            <tbody>
            {% for item in this.pager %}
                {%- set table_body -%}
                    {% block table_body %}{% endblock %}
                {%- endset -%}

                <tr>
                    {% if this.displayListType.isImagedTable %}
                        <td class="text-center">
                            <twig:entity-image
                                :entity="item"
                                classes="data-grid-imaged-table-image"
                            />
                        </td>
                    {% endif %}

                    {{ table_body }}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

{{ pagination }}
