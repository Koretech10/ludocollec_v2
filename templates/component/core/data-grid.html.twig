{% set pagination %}
    <twig:data-grid-pagination
        :pager="this.pager"
        :filterModalId="this.filterModalId"
        :hasFilterType="this.hasFilterType"
        :isFiltered="this.dataGrid.isFiltered"
    />
{% endset %}

{{ knp_pagination_rel_links(this.pager) }}

{% if this.displayListType.isCardGrid %}
    <twig:modal id="sort_modal">
        <twig:block name="title">Trier</twig:block>

        {% set sortType = outerScope.this.sortType %}

        {{ form_start(sortType) }}
        <div class="d-flex mb-2">
            <div class="flex-grow-1 me-1">
                {{ form_widget(sortType.field) }}
            </div>
            <div class="flex-shrink-1">
                {{ form_widget(sortType.direction) }}
            </div>
        </div>
        <twig:button additionalClasses="btn-auto" submit>
            <twig:icon :icon="Icon.sort" />
            Trier
        </twig:button>

        {{ form_end(sortType) }}
    </twig:modal>
{% endif %}

{% if this.hasFilterType %}
    {% include 'component/core/_data_grid_filter_modal.html.twig' with {
        filter_modal_id: this.filterModalId,
        filter_type: this.filterType
    } only %}
{% endif %}

{{ pagination }}

{% if this.displayListType.isCardGrid %}
    <div class="row row-cols-1 row-cols-sm-3 g-2">
        {% for item in this.pager %}
            {# @var item \App\Entity\ImageableEntity #}

            {%- set card_body -%}
                {% block card_body %}{% endblock %}
            {%- endset -%}

            <div class="col">
                <twig:entity-card cardClass="h-100" :entity="item">
                    {{ card_body }}
                </twig:entity-card>
            </div>
        {% endfor %}
    </div>
{% endif %}

{% if this.displayListType.isTable %}
    <div class="table-responsive">
        <table class="table data-grid-table">
            <thead>
            <tr>
                {% if this.displayListType.isImagedTable %}
                    <th>&nbsp;</th>
                {% endif %}

                {% for header in this.headers %}
                    {# @var header \App\Model\Core\DataGrid\DataGridHeader #}

                    {% if header.key is null %}
                        <th>{{ header.label }}</th>
                    {% else %}
                        <th>{{ knp_pagination_sortable(this.pager, header.label, header.key) }}</th>
                    {% endif %}
                {% endfor %}

                {% if not this.hideActions %}
                    <th>&nbsp;</th>
                {% endif %}
            </tr>
            </thead>
            <tbody>
            {% for item in this.pager %}
                {%- set table_body -%}
                    {% block table_body %}{% endblock %}
                {%- endset -%}

                <tr>
                    {% if this.displayListType.isImagedTable %}
                        <td class="text-center">
                            <twig:entity-image
                                :entity="item"
                                classes="data-grid-imaged-table-image"
                            />
                        </td>
                    {% endif %}

                    {{ table_body }}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}

{{ pagination }}
