{% set dropdown_toggle %}
    {% block dropdown_toggle %}{% endblock %}
{% endset %}

<div class="dropdown btn-group">
    <twig:button dropdownToggle :type="this.type" :outlined="this.outlined" :additionalClasses="this.getToggleButtonClasses()">{{ dropdown_toggle }}</twig:button>

    <ul class="dropdown-menu">
        {% for item in items %}
            <li>
                {% block content %}{% endblock %}
            </li>
        {% endfor %}
    </ul>
</div>
