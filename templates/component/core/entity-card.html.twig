{%- set content -%}
    {% block content %}{% endblock %}
{%- endset -%}

<twig:card :cardClass="cardClass" :headerClass="headerClass" :contentClass="contentClass" :footerClass="footerClass">
    <twig:block name="header">
        <a class="h5 stretched-link" href="{{ outerScope.this.getShowPath() }}">
            <twig:truncated-text :text="outerScope.this.entity.title" :size="outerScope.this.truncateSize" :direction="Direction.top" />
        </a>
    </twig:block>

    {% set actions = outerScope.this.actions %}
    {% set entity = outerScope.this.entity %}

    <div class="row gy-0 gx-5 gx-sm-2">
        {% if content is not empty %}
            <div class="col-4 mx-auto d-flex align-items-center">
                <twig:entity-image :entity="entity" classes="data-grid-card-image d-block mx-auto" noBorder />
            </div>

            <div class="col">
                {{ content }}

                {% if actions is not null %}
                    <div class="mt-3 d-flex flex-row-reverse">
                        <twig:data-grid-actions :actions="actions" :item="entity" />
                    </div>
                {% endif %}
            </div>
        {% else %}
            <div class="mx-auto">
                <twig:entity-image :entity="entity" classes="data-grid-card-image d-block mx-auto" noBorder />
            </div>
        {% endif %}

    </div>
</twig:card>
