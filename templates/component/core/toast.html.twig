<div
    class="toast toast-flash bg-{{ this.type.value }}"
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
>
    <div class="d-flex">
        <div class="toast-body">
            {%- block content -%}{%- endblock -%}
        </div>

        <twig:button
            :type="Type.SUCCESS"
            additionalClasses="me-2 m-auto"
            additionalAttributes="data-bs-dismiss='toast'"
        >
            <twig:icon :icon="Icon.cancel" />
        </twig:button>
    </div>

    <div class="toast-progress"></div>
</div>
