<div
    class="toast bg-{{ this.type.value }}"
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
>
    <div class="toast-body">
        <div>
            <twig:icon :icon="this.type.icon" class="toast-icon text-center" />
        </div>

        <div class="flex-grow-1">
            {%- block content -%}{%- endblock -%}
        </div>

        <div>
            <twig:button :type="this.type" additionalAttributes="data-bs-dismiss='toast'">
                <twig:icon :icon="Icon.cancel" />
            </twig:button>
        </div>
    </div>

    <div class="toast-progress"></div>
</div>
