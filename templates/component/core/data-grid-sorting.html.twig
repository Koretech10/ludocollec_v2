<twig:dropdown outlined :items="this.headers">
    <twig:block name="dropdown_toggle"><twig:icon :icon="Icon.sort" /> Trier</twig:block>

    {% set header = item %}
        {# @var header App\Model\Core\DataGrid\DataGridHeader #}

        {% if header.key is not null %}
            {% set isActive = outerScope.this.active(header.key) %}
            {% set currentDirection = outerScope.this.currentDirection %}
            {% set href = outerScope.this.url(header.key) %}

            <twig:dropdown:item :href="href" :active="isActive">
                {% if isActive %}
                    {% if 'asc' == currentDirection %}
                        <twig:icon :icon="Icon.sort_asc" />
                    {% else %}
                        <twig:icon :icon="Icon.sort_desc" />
                    {% endif %}
                {% else %}
                    <twig:icon :icon="Icon.sort" />
                {% endif %}

                {{ header.label }}
            </twig:dropdown:item>
        {% endif %}
</twig:dropdown>
