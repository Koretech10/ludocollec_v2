{% extends 'base.html.twig' %}

{% block body %}
    <twig:data-grid :dataGrid="data_grid">
        <twig:block name="card_body">
            {% set toy = item %}
            {# @var toy \App\Entity\Toy\Toy #}

            <twig:info label="Série">{{ toy.series.name }} ({{ toy.series.brand.label }})</twig:info>
            <twig:info label="Fabricant">{{ toy.manufacturer.name }}</twig:info>
            <twig:info label="Sortie"><twig:date :date="toy.releaseDate" /></twig:info>
        </twig:block>

        <twig:block name="table_body">
            {% set toy = item %}
            {# @var toy \App\Entity\Toy\Toy #}

            <td>
                <a href="{{ path('toy.show', { id: toy.id }) }}">{{ toy.name }}</a>
            </td>
            <td>{{ toy.series.name }} ({{ toy.series.brand.label }})</td>
            <td>{{ toy.manufacturer.name }}</td>
            <td><twig:date :date="toy.releaseDate" /></td>
            <td>{# ToDo #}</td>
        </twig:block>
    </twig:data-grid>
{% endblock %}
