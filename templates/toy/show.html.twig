{# @var user \App\Entity\User\User #}
{# @var toy \App\Entity\Toy\Toy #}
{# @var collection_toy_entries_count int #}
{# @var wishlist_toy_entries_count int #}
{# @var user_collection_toy_entries_count int|null #}
{# @var user_wishlist_toy_entries_count int|null #}

{% extends 'base.html.twig' %}

{% block body %}
    <div class="row">
        <div class="col-12 mb-2 col-sm-3">
            {% include 'toy/show/_image.html.twig' with { toy: toy } only %}
        </div>

        <div class="col-12 mb-2 col-sm-5">
            {% include 'toy/show/_info.html.twig' with { toy: toy } only %}
        </div>

        <div class="col-12 mb-2 col-sm-4">
            {% include 'toy/show/_stats.html.twig' with {
                user,
                toy,
                collection_toy_entries_count,
                wishlist_toy_entries_count,
                user_collection_toy_entries_count,
                user_wishlist_toy_entries_count,
            } only %}
        </div>
    </div>
{% endblock %}
