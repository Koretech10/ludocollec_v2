{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-12 col-sm-6">
            <div class="col-12 my-3">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Bienvenue sur LudoCollec</h5>
                    </div>

                    <div class="card-body">
                        <iframe
                            height="400px"
                            style="width: 100%"
                            src="https://www.youtube.com/embed/TWdfc6kjizo?autoplay=1&mute=1&cc_load_policy=1"
                            frameborder="0"
                            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                        ></iframe>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-12 col-sm-6 my-3">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Statistiques</h5>
                        </div>

                        <div class="card-body">
                            <twig:info label="Jeux vidéo" value="10 465" />

                            <twig:info label="Plateformes" value="649" />

                            <twig:info label="Accessoires" value="912" />

                            <twig:info label="Jouets vidéo" value="1 040" />

                            <twig:info label="Membres" value="122" />

                            <twig:info label="Entrées de collection" value="17 468" />

                            <twig:info label="Entrées de wishlist" value="1 234" />

                            <twig:info label="Listes personnalisées" value="149" />
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 my-3">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="card-title">Aidez LudoCollec</h5>
                        </div>

                        <div class="card-body">
                            <a class="btn btn-youtube" href="https://fr.tipeee.com/ludocollec" style="width: 100%;">
                                <twig:icon name="hall_of_fame" class="fs-1"></twig:icon>
                                <br />
                                <span class="fs-3">Faites un don sur Tipeee</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6">
            <div class="col-12 my-3">
                <div class="card">
                    <div class="card-header">
                        <h5 class="card-title">Derniers ajouts</h5>
                    </div>

                    <div class="card-body row" style="box-sizing: border-box;">
                        {% for i in 1..16 %}
                            {% include 'static/home/_card_placeholder.html.twig' %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
