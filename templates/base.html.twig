<!doctype html>
<html lang="fr">
<head>
    <title>{{ block('title') }} | LudoCollec</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/png" href="{{ asset('images/logo100px.png') }}" />
    {{ vite_entry_link_tags('app') }}
    {% block additional_css %}{% endblock %}
</head>

<body>
    <div class="content-wrapper">
        <div class="content-container row">
            {% include 'layout/sidebar.html.twig' %}

            <div class="content-body col">
                <header>
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            {% block header_breadcrumb %}
                                {# ToDo A supprimer quand le fil d'ariane sera fonctionnel #}
                                <li class="breadcrumb-item" aria-current="page">Accueil</li>
                                <li class="breadcrumb-item"><a href="#">Library</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Data</li>
                            {% endblock %}
                        </ol>
                    </nav>
                </header>

                <main class="row">
                    <div class="action-bar">
                        {% block action_bar %}{% endblock %}
                    </div>

                    <div class="main-body">
                        {% block body %}{% endblock %}
                    </div>
                </main>

                <footer class="row">
                    {% include 'layout/footer.html.twig' %}
                </footer>
            </div>
        </div>
    </div>

    {{ vite_entry_script_tags('app') }}
    {% block additional_js %}{% endblock %}
</body>
</html>
