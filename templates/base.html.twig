<!doctype html>
<html lang="fr">
<head>
    <title>{{ block('title') }} | LudoCollec</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ vite_entry_link_tags('app') }}
    {% block additional_css %}{% endblock %}
</head>

<body>
    <div class="content-wrapper">
        <div class="content-container row">
            {% include 'layout/sidebar/sidebar.html.twig' %}

            <div class="content-body col">
                <header class="row">
                    <div class="col">
                        <h1>Header here</h1>
                    </div>
                </header>

                <main class="row">
                    <div class="col pt-4">
                        <h1>Content here</h1>
                        {% block body %}{% endblock %}
                    </div>
                </main>

                <footer class="row">
                    {# Copyright #}
                    <div class="col-sm col-12 text-center text-sm-start">
                        <span>
                            © 2018 - {{ 'now' | date('Y') }}
                            <a href="https://x.com/KoretechYT" target="_blank">Koretech</a>
                        </span>
                    </div>

                    {# Liens #}
                    <div class="col-sm col-12 text-center">
                        <a href="#ToDo">A propos</a>
                        <a href="#ToDo">Mentions légales</a>
                    </div>

                    {# Réseaux sociaux #}
                    <div class="col-sm col-12 text-center social-links">
                        <a class="text-twitter-x" href="https://x.com/ludocollec" target="_blank">
                            <i class="bi bi-twitter-x"></i>
                        </a>
                        <a class="text-youtube" href="https://www.youtube.com/channel/UCIpFSLm46ZxJcMrxT0QrNgw" target="_blank">
                            <i class="bi bi-youtube"></i>
                        </a>
                        <a class="text-twitch" href="https://twitch.tv/ludocollec" target="_blank">
                            <i class="bi bi-twitch"></i>
                        </a>
                        <a class="text-discord" href="https://discord.gg/SuKUZBuACA" target="_blank">
                            <i class="bi bi-discord"></i>
                        </a>
                        <a class="text-github" href="https://github.com/Koretech10/ludocollec_v2" target="_blank">
                            <i class="bi bi-github"></i>
                        </a>
                    </div>

                    {# Version et changelog #}
                    <div class="col-sm col-12 text-center text-sm-end">
                        <a href="#ToDo">Version 2.0.0 Beta</a>
                    </div>
                </footer>
            </div>
        </div>
    </div>

    {{ vite_entry_script_tags('app') }}
    {% block additional_js %}{% endblock %}
</body>
</html>
