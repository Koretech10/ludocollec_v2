{
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316",
  "devDependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.2.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-symfony": "^8.2.4"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build"
  },
  "lint-staged": {
    "src/**/*.php": [
      "symfony php ./vendor/bin/php-cs-fixer fix --config=config/checkers/.php-cs-fixer.dist.php --cache-file=var/php_cs.cache",
      "symfony php ./vendor/bin/phpstan analyse -c config/checkers/phpstan.neon"
    ],
    "templates/**/*.twig": "symfony console lint:twig",
    "assets/**/*.ts": "prettier --write --ignore-unknown"
  }
}
