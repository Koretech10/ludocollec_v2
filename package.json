{
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c",
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "sass": "^1.94.0",
    "vite": "^7.2.2",
    "vite-plugin-symfony": "^8.2.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build"
  },
  "lint-staged": {
    "src/**/*.php": [
      "symfony php ./vendor/bin/php-cs-fixer fix --config=config/checkers/.php-cs-fixer.dist.php --cache-file=var/php_cs.cache",
      "symfony php ./vendor/bin/phpstan analyse -c config/checkers/phpstan.neon"
    ],
    "templates/**/*.twig": "symfony console lint:twig",
    "assets/*": "prettier --write --ignore-unknown"
  }
}
