{
  "packageManager": "pnpm@10.13.1+sha512.37ebf1a5c7a30d5fabe0c5df44ee8da4c965ca0c5af3dbab28c3a1681b70a256218d05c81c9c0dcf767ef6b8551eb5b960042b9ed4300c59242336377e01cfad",
  "devDependencies": {
    "bootstrap": "^5.3.7",
    "bootstrap-icons": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "vite": "^6.0",
    "vite-plugin-symfony": "^8.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build"
  },
  "lint-staged": {
    "src/**/*.php": [
      "symfony php ./vendor/bin/php-cs-fixer fix --config=config/checkers/.php-cs-fixer.dist.php --cache-file=var/php_cs.cache",
      "symfony php ./vendor/bin/phpstan analyse -c config/checkers/phpstan.neon"
    ],
    "templates/**/*.twig": "symfony console lint:twig",
    "assets/*": "prettier --write --ignore-unknown"
  }
}
