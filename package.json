{
  "packageManager": "pnpm@10.20.0+sha512.cf9998222162dd85864d0a8102e7892e7ba4ceadebbf5a31f9c2fce48dfce317a9c53b9f6464d1ef9042cba2e02ae02a9f7c143a2b438cd93c91840f0192b9dd",
  "devDependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "sass": "^1.94.0",
    "vite": "^7.2.2",
    "vite-plugin-symfony": "^8.2.2"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build"
  },
  "lint-staged": {
    "src/**/*.php": [
      "symfony php ./vendor/bin/php-cs-fixer fix --config=config/checkers/.php-cs-fixer.dist.php --cache-file=var/php_cs.cache",
      "symfony php ./vendor/bin/phpstan analyse -c config/checkers/phpstan.neon"
    ],
    "templates/**/*.twig": "symfony console lint:twig",
    "assets/*": "prettier --write --ignore-unknown"
  }
}
